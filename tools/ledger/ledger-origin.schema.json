{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orion Ledger Origin Marker",
  "description": "Marcador de origem do Feature Ledger (ADR-0021). 'orion' = repo origem/template; 'local' = repo derivado com origem local estabelecida (entradas herdadas viram 'pré-origem-local', fora do escopo do ADR-0016).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": { "const": "orion" },
        "note": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "bootstrappedOn", "seedSha256", "inheritedEntryIds"],
      "properties": {
        "origin": { "const": "local" },
        "bootstrappedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Data ISO (YYYY-MM-DD) do bootstrap humano (getting-started §2)."
        },
        "seedSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Fingerprint da semente herdada (subconjunto pré-origem-local)."
        },
        "inheritedEntryIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ids herdados do template — 'pré-origem-local', fora do escopo de projeção."
        },
        "note": { "type": "string" }
      }
    }
  ]
}
