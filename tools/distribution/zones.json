{
  "$comment": "Manifesto de zonas do O16 (ADR-0047). Única lista concreta: cada arquivo rastreado casa exatamente um padrão de uma zona. Padrões: caminho exato ou prefixo 'dir/**'. Mudar a zona de um arquivo é mudança deste manifesto revisada no PR; mudar regra ou teto é emenda do ADR-0047 (G2).",
  "version": 1,
  "limits": {
    "zoneB": 30
  },
  "zones": {
    "A": {
      "description": "Pacote: o que roda, constrói ou é consumido pelo harness. Não fica no repo do produto.",
      "paths": [
        "tools/**",
        "docs/examples/**",
        "scripts/**",
        "presets/**",
        "skills/**",
        "package.json",
        "package-lock.json",
        "tsconfig.json",
        "eslint.config.mjs",
        "vitest.config.ts",
        ".prettierrc.json",
        ".prettierignore"
      ]
    },
    "B": {
      "description": "Gerenciado: fica no repo do produto porque tem leitor que só o encontra ali (agente, GitHub, ferramenta na raiz). Substituído no update; congelado pelo freeze guard.",
      "paths": [
        "AGENTS.md",
        "AGENTS.core.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "docs/agent-reviewer-checklist.md",
        "docs/harness-reviewer-checklist.md",
        "docs/architecture/foundations.md",
        "docs/architecture/ui-agent-harness.md",
        "docs/testing-strategy.md",
        "docs/observability.md",
        ".github/workflows/ci.yml",
        ".github/workflows/cross-model.yml",
        ".github/workflows/flip-batch.yml",
        ".github/workflows/flip-invalidate.yml",
        ".github/workflows/flip-liveness.yml",
        ".github/workflows/flip-revalidate.yml",
        ".github/workflows/labels.yml",
        ".github/workflows/project-board.yml",
        ".github/labels.yml",
        ".github/PULL_REQUEST_TEMPLATE.md",
        ".github/ISSUE_TEMPLATE/sdd-task.yml",
        ".github/ISSUE_TEMPLATE/config.yml",
        ".pre-commit-config.yaml",
        "commitlint.config.js",
        ".editorconfig"
      ]
    },
    "C": {
      "description": "Semente do produto: copiado uma vez pelo orion new e daí em diante do produto; o update nunca toca.",
      "paths": ["docs/product/**"]
    },
    "D": {
      "description": "Só do central: nunca distribuído. Os caminhos em generatedCounterpart existem no produto com conteúdo próprio, gerado pelo orion new (Zona C no produto).",
      "paths": [
        "docs/decisions/**",
        "docs/plans/**",
        "docs/README.md",
        "docs/runbooks/**",
        ".github/workflows/release.yml",
        ".github/ISSUE_TEMPLATE/.gitkeep",
        "README.md",
        "LICENSE",
        "CODEOWNERS",
        "SECURITY.md",
        "STATE.md",
        "PLAN.md",
        "CHANGELOG.md",
        "MEMORY.md",
        "feature-ledger.json",
        ".orion/ledger-origin.json",
        ".orion/ledger-lifecycle.json",
        ".orion/state-budget.json",
        "init.sh",
        ".env.example",
        ".gitignore",
        ".gitleaksignore",
        ".nvmrc",
        ".github/dependabot.yml",
        "docs/getting-started.md"
      ],
      "generatedCounterpart": [
        "README.md",
        "LICENSE",
        "CODEOWNERS",
        "SECURITY.md",
        "STATE.md",
        "PLAN.md",
        "CHANGELOG.md",
        "MEMORY.md",
        "feature-ledger.json",
        ".orion/ledger-origin.json",
        ".orion/ledger-lifecycle.json",
        ".orion/state-budget.json",
        "init.sh",
        ".env.example",
        ".gitignore",
        ".gitleaksignore",
        ".nvmrc",
        ".github/dependabot.yml",
        "docs/getting-started.md"
      ]
    }
  }
}
